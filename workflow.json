        "jsCode": "const create = $input.first().json;\nconst record = $('Score').first().json;\nlet gid = null;\nconst reply = (create.replies || [])[0];\nif (reply && reply.addSheet && reply.addSheet.properties && typeof reply.addSheet.properties.sheetId === 'number') {\n  gid = reply.addSheet.properties.sheetId;\n}\nconst ledger = 'https://docs.google.com/spreadsheets/d/10YVSSuDSKqThb0WdB-CILBr_Ez__wAtR6nAWl1QY4tM/edit';\nrecord.tab_gid = gid;\nrecord.tab_url = gid !== null ? ledger + '#gid=' + gid : ledger;\nreturn [{ json: record }];\n"
